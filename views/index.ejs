<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parkolok</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <ul>
        <li>
            <a href="/">Fooldal</a>
        </li>
        <li>
            <a href="/new-parkolo">Uj parkolo</a>
        </li>

    </ul>
    <table>
        <thead>
            <tr>
                <th>
                    ID
                </th>
                <th>
                    Rendszam
                </th>
                <th>
                    Tulajdonos
                </th>
                <th>
                    Idotartam
                </th>
            </tr>
        </thead>
        <tbody>
            <%parkolok.forEach((parkolo)=>{%>
                <tr class="<%= parkolo.fizetve ? 'payed' : 'not-payed' %>">
                    <td>
                        <%=parkolo.id%>
                    </td>
                    <td>
                        <%=parkolo.rendszam%>
                    </td>
                    <td>
                        <%=parkolo.tulajdonos%>
                    </td>
                    <td>
                        <%=parkolo.idotartam%>
                    </td>
                </tr>
                <%})%>
        </tbody>
    </table>
</body>

</html>